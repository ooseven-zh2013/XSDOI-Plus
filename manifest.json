{
  "manifest_version": 3,
  "name": "XSDOI-Plus",
  "version": "2.1.1",
  "description": "新赛道 OI（xsdoi.com）一站式增强：图标替换、AC 动画替换、题目 Markdown 复制、自测结果复制、暗色模式修复、板块亚克力美化、页面背景替换、代码自动备份、文件IO复制Cpp格式",
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite"],
  "host_permissions": ["*://xsdoi.com/*", "*://*.xsdoi.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "XSDOI-Plus",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://xsdoi.com/*", "*://*.xsdoi.com/*"],
      "js": ["constants.js", "content/ac.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://xsdoi.com/*", "*://*.xsdoi.com/*"],
      "js": ["constants.js", "content/bg.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://xsdoi.com/*", "*://*.xsdoi.com/*"],
      "js": ["content/board-beautify.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://xsdoi.com/*"],
      "js": ["content/logo.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.xsdoi.com/*"],
      "js": ["content/md-dark-fix.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*.xsdoi.com/*"],
      "js": ["md-core.js", "content/md-problem-copy.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://xsdoi.com/*", "*://*.xsdoi.com/*"],
      "js": ["content/md-error-copy.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://xsdoi.com/*", "*://*.xsdoi.com/*"],
      "js": ["content/auto-save-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["*://xsdoi.com/*", "*://*.xsdoi.com/*"],
      "js": ["content/auto-save.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://xsdoi.com/*"],
      "js": ["content/cpp-file-io-copy.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/builtin-logo.png"],
      "matches": ["*://xsdoi.com/*"]
    }
  ]
}
